# ──────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for local development.
# On Vercel: Project → Settings → Environment Variables.
# The site runs without any of these — each one turns on a feature.
# ──────────────────────────────────────────────────────────────

# ── 1. LEAD DASHBOARD PASSWORD (required for /admin) ──────────
# Until this is set, /admin stays locked and the API refuses every
# request. Use something long — this is the only thing protecting
# your lead list.
ADMIN_PASSWORD=

# ── 2. LEAD STORAGE (strongly recommended) ────────────────────
# Without these, leads are held in memory and disappear when the
# server restarts. On Vercel that means you WILL lose leads.
# Free setup takes about 5 minutes — see SETUP-LEADS.md.
# SUPABASE_URL   → Settings > API > Project URL
# SUPABASE_SERVICE_KEY → Settings > API Keys > Secret key (sb_secret_...)
#   or the legacy service_role key. NOT the publishable/anon key —
#   that one cannot read your leads. Server-side only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: locks the daily keep-alive cron that stops Supabase's free
# tier pausing your database. Any long random string. Vercel sends it
# automatically on cron requests.
CRON_SECRET=

# ── 3. EMAIL NOTIFICATIONS ────────────────────────────────────
# 1. Turn on 2-Step Verification for your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (spaces are fine)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where enquiries arrive (defaults to the site email, info@flowzync.com)
CONTACT_TO=

# ── 3b. SPAM PROTECTION (optional) ────────────────────────────
# The contact form and chatbot use a built-in spam check: a signed
# maths question, a honeypot field and a minimum fill time. No third
# party or account needed. It signs with ADMIN_PASSWORD by default;
# set this only if you want a separate secret.
CAPTCHA_SECRET=

# ── 4. AI CHAT (pick ONE — both free options work well) ───────
# Option A (recommended, free): https://console.groq.com → API Keys
GROQ_API_KEY=

# Option B (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option C (paid, optional): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Without any key, Zync still answers using its built-in knowledge
# base and still captures leads — it just isn't free-form conversational.
